# Copy this file to .env and fill in the real values before running.
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://cloudlab:cloudlab_pw@postgres:5432/cloudlab
POSTGRES_USER=cloudlab
POSTGRES_PASSWORD=cloudlab_pw
POSTGRES_DB=cloudlab

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-real-secret-at-least-32-chars

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_VERTEX=false

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
IDLE_TIMEOUT_MINUTES=30
